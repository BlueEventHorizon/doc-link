    {
      "content_hash": "e39053afeaab1c40899a7bfb09c7f7ccd38d2926d6ce731acfd2beb8177304c2",
      "heading": "DES-001 システム全体設計",
      "position": 0,
      "section_id": "DLID-he599f4215xq"
    }
  ],
  "summary": [
    "System boundary: doc-link replaces DocAdvisor and handles document IDs, ToC, search, DLID resolution, reference checks and change-impact notification",
    "Write boundary: only DLIDs may be written to indexed documents, in frontmatter and heading-line suffixes, by the explicit DLID assignment operation only",
    "Operation table: inputs, results handed downstream and write boundary for DLID assignment, ToC build, search, DLID resolution, reference check, impact notification and inconsistency check",
    "Search backend (doc-db or ToC) is decided at the entry of ToC build and search; machine-acquired information is always built",
    "ToC build flow: target fixing, ID check, change detection, information acquisition, reference check, candidate check, confirmation",
    "Overall sequence diagram of index-docs followed by check-impact in the normal case",
    "Common invariants: independent document IDs, real directory scan for references, no partial candidate publication, no stored notification state, per-key update isolation",
    "Deferred items: storage as JSON files and multi-key visibility are decided in the individual designs"
  ],
  "tasks": [
    "Designing or revising any doc-link detailed design",
    "Understanding the overall doc-link architecture before implementation",
    "Checking write-boundary compliance for indexed documents",
    "Reviewing consistency between requirements and designs",
    "Implementing ToC build, search or impact notification operations",
    "Designing the doc-db and ToC backend switch integration"
  ],
  "title": "DES-001 システム全体設計"
}
